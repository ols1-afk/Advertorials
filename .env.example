# Copy to .env and fill in as needed. Nothing here is required to run the
# landing page: it needs no database, no sign-in, and its images are committed.

# Server
PORT=3000

# Database (optional - omit and DB-backed features become no-ops)
DATABASE_URL=

# Auth (Manus OAuth). Only needed if you add signed-in features.
JWT_SECRET=
OAUTH_SERVER_URL=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Manus Forge API. Backs the /manus-storage/* proxy, which this page does not
# use - its images are served from client/public/images/.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
